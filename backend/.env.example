# Yojana Hunter Backend Configuration Example
PROJECT_NAME="Yojana Hunter"
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=127.0.0.1

# PostgreSQL Database Connection URL (PostgreSQL 18)
DATABASE_URL=postgresql+psycopg://postgres:<YOUR_POSTGRES_PASSWORD>@localhost:5432/yojana_hunter

# Secrets
SECRET_KEY=your-secret-key-placeholder
JWT_SECRET=your-jwt-secret-placeholder

# Frontend URL (for password reset redirects and CORS)
FRONTEND_URL=http://localhost:3000

# Optional Email Service (SMTP) for Password Reset Emails
# If not configured, password reset tokens are logged to application logs in development mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@yojanahunter.gov.in

# Gemini AI API Configuration (Official Google Gen AI SDK)
# Required for Search Grounded Scheme Discovery and AI Eligibility Explanations
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=30
DISCOVERY_MAX_REQUESTS=10

# Razorpay Payment Gateway Configuration (Test Mode)
# Get your API keys from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Pre-created Razorpay Plan IDs (from Razorpay Dashboard > Subscriptions > Plans)
# Optional: create plans once in the dashboard and paste their IDs here to avoid dynamic plan creation
RAZORPAY_PLAN_ID_MONTHLY=
RAZORPAY_PLAN_ID_TWO_MONTHS=
RAZORPAY_PLAN_ID_YEARLY=

